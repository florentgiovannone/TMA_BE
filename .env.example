# Database (use Amazon RDS endpoint in production)
PGHOST=localhost
PGPORT=5432
# Second SSH local forward (-L 5433:localhost:5432). Merged into /api/items.
# Set empty to use PGPORT only.
PGPORT_EXTRA=5433
PGDATABASE=aba_cards
# Database name on PGPORT_EXTRA. Port 5432 keeps PGDATABASE.
PGDATABASE_EXTRA=cards
PGUSER=poise
PGPASSWORD=

# API auth (change in production)
DASHBOARD_PASSWORD=tma-dashboard
# Arkın Rodin app (/dashboard on arkingallery) — sent with X-Dashboard-App: arkin
DASHBOARD_PASSWORD_ARKIN=rodin-dashboard

# Rows per request for /api/items (defaults; override with ?limit=)
# POISE_LOG_LIMIT=25000
# POISE_LOG_MAX_LIMIT=100000

# Optional CORS
# CORS_EXTRA_ORIGINS=https://my-preview.netlify.app
# ALLOW_NGROK_CORS=0

# Local dev only
# PORT=5050
